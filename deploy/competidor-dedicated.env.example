# Loaded AFTER /etc/competidor.env, so the old profile cannot override this file.
# Only for the exclusive 8-vCore / 16-GB server. Contains no account secrets.
COMPETIDOR_PERFORMANCE_PROFILE=dedicated-16gb
COMPETIDOR_MEMORY_TRIM_RSS_MB=9216
COMPETIDOR_GC_GENERATION0_THRESHOLD=50000
COMPETIDOR_HTTP_MAX_CONCURRENT_REQUESTS=96
COMPETIDOR_HTTP_REQUEST_QUEUE=256
COMPETIDOR_HTTP_KEEPALIVE_TIMEOUT_SECONDS=30
COMPETIDOR_MANUAL_CONCURRENT_JOBS=4
MELI_CLONE_CONCURRENT_JOBS=4
COMPETIDOR_BACKGROUND_CONCURRENT_JOBS=2
COMPETIDOR_HEAVY_CONCURRENT_JOBS=1
MELI_INTERACTIVE_MAX_IN_FLIGHT=8
MELI_BACKGROUND_MAX_IN_FLIGHT=6
